# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Config locale
config.json

# Logs
*.log

# Environments
.venv
env/
venv/
ENV/

# PyInstaller / Build & Dist
build/
dist/
# *.spec est VERSIONNÉ (AntigravityManager.spec) : filtrage Qt intégré.
# On ignore seulement les .spec générés à la volée par un build ad hoc.
_*.spec

search_index.db*
claude_search_index.db*

# Exports Markdown de conversations (générés par la fonctionnalité Export)
_conversations/

# Archives automatiques des conversations (archive.py) — copies de secours
_archive/

# Répertoire de travail temporaire (diagnostics, dumps ad hoc)
temp/

# Coordination multi-agents locale (mcp-multi-ai) : état de session, pas du code
.mcp-multi-ai/
agents.config.json

# Cache dérivé de la source Codex
codex_search_index.db*
